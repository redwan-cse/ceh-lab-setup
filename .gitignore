# Publish only the maintained setup kit; exclude runtime artifacts and credentials.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/ceh-local-lab/
!/universal/
!/exam/

# Never publish runtime credentials, profiles, logs, caches or local archives.
**/__pycache__/
**/*.py[cod]
**/*.log
**/*.zip
**/.sgptrc
**/.env
**/.env.*
**/.gemini-api-key
**/.*-api-key
**/provider-keys.json
**/id_rsa*
**/id_ed25519*
**/authorized_keys
**/administrators_authorized_keys
**/credentials
**/CEH-Tools/
**/CEH-Tools-Staging/
**/CEH-Exam/
**/ceh-tools-deployment/
**/*.pem
**/*.pfx
**/*.key
**/venv/
**/.venv/
**/node_modules/
**/cache*/
